# ============================================================
# Millath College ERP — environment variable template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Django core
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Which settings module to use
# Development:   config.settings.development
# Production:    config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL for production; SQLite used in development by default)
DATABASE_URL=postgres://user:password@localhost:5432/millath_erp

# Email (production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Millath College ERP <noreply@example.com>
